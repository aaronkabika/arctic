# Arctic Configuration Example
# Copiez ce fichier vers .env et remplacez les valeurs

# Secret key pour Flask (générez une clé aléatoire sécurisée)
ARCTIC_SECRET_KEY=your_very_secret_key_here_change_in_production

# Environment (development, production, testing)
FLASK_ENV=development

# Debug mode (True pour développement, False pour production)
FLASK_DEBUG=True

# Database URL
# Développement (SQLite): sqlite:///arctic.db
# Production (PostgreSQL): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///arctic.db

# Upload folder (optionnel, par défaut uploads)
UPLOAD_FOLDER=uploads

# Max file size in MB (optionnel, par défaut 25)
MAX_CONTENT_LENGTH=25
