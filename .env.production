# Arctic Production Configuration for Vercel
# NE PAS COMMITER CE FICHIER - Configurer dans Vercel Dashboard

# Secret key pour Flask (générez une clé aléatoire sécurisée)
ARCTIC_SECRET_KEY=your_production_secret_key_here

# Environment
FLASK_ENV=production
FLASK_DEBUG=False

# PostgreSQL Database URL (format: postgresql://user:password@host:port/database)
# Exemple Neon: postgresql://username:password@ep-xxx.region.aws.neon.tech/arctic
# Exemple Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:port/arctic

# Upload folder (Vercel utilise /tmp pour les fichiers temporaires)
UPLOAD_FOLDER=/tmp/uploads

# Max file size in MB
MAX_CONTENT_LENGTH=25
